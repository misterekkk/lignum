# target to preprocess a source file
src/validate.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/lignum.dir/build.make CMakeFiles/lignum.dir/src/validate.cpp.i
.PHONY : src/validate.cpp.i

src/validate.s: src/validate.cpp.s
.PHONY : src/validate.s

# target to generate assembly for a file
src/validate.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/lignum.dir/build.make CMakeFiles/lignum.dir/src/validate.cpp.s
.PHONY : src/validate.cpp.s

